# Copy to .env (project root) and fill in. Never commit .env.
# Save it as UTF-8 (PowerShell's `>` writes UTF-16, which python-dotenv can't read).

# Use the Gemini API (AI Studio key), not Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key

# Gemini model used by the vigil agent.
VIGIL_MODEL=gemini-flash-latest
# Used when VIGIL_MODEL is still overloaded (503/429) after retries. Leave empty to disable.
VIGIL_FALLBACK_MODEL=gemini-flash-lite-latest
# Overall time budget for one analysis, in seconds.
VIGIL_TIMEOUT_S=120

# Web app
RATE_LIMIT=5
RATE_WINDOW_S=600
MAX_CONCURRENT_ANALYSES=2
# Set to 1 behind Cloudflare Tunnel / Caddy: rate-limit by CF-Connecting-IP
# (then the first X-Forwarded-For entry) instead of the socket address.
TRUST_PROXY=0
